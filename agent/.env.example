# Sentinel agent — environment template (copy to .env, never commit a real key)
# Base Sepolia RPC (publicnode works from this sandbox; sepolia.base.org times out)
RPC_URL=https://base-sepolia-rpc.publicnode.com
# RiskOracle deployed on Base Sepolia (Phase 2)
ORACLE_ADDRESS=0xdc4e2FD88491C69058509fFb5638EF2D266f0C7e
# Path to the fresh testnet-only wallet key (mode 600). Never the main wallet.
WALLET_KEY_PATH=../wallet-testnet.json

# LLM provider (pluggable, OpenAI-compatible chat completions).
# Default: Groq free tier. No key exists yet — without one the agent runs the
# built-in mock provider (rule-based score from the 24h price change).
# SENTINEL_LLM_API_KEY=
SENTINEL_LLM_BASE_URL=https://api.groq.com/openai/v1
SENTINEL_LLM_MODEL=qwen/qwen3.8-27b
# Poll interval between price checks (ms). Demo uses --demo instead.
POLL_INTERVAL_MS=300000
